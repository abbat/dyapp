FROM rust@sha256:3745c050d12adc738eff16ebfc81ed044bfb2cc27c6828850ff1666beb1c7a49 AS rust
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config ca-certificates libssl-dev libgtk-3-dev \
    libwebkit2gtk-4.1-dev libxdo-dev libayatana-appindicator3-dev librsvg2-dev \
    xvfb xauth dbus-x11 python3
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo RUSTUP_TOOLCHAIN=1.99.0 \
    CARGO_BUILD_JOBS=4 CMAKE_BUILD_PARALLEL_LEVEL=4 MAKEFLAGS=-j4 \
    RAYON_NUM_THREADS=4
RUN groupadd -g 999 appuser && useradd -m -u 999 -g 999 appuser
WORKDIR /app
COPY Cargo.toml ./
COPY rust rust
COPY proto proto
COPY clients clients
RUN cargo fetch --locked --manifest-path clients/linux/Cargo.toml && \
    cargo build --manifest-path clients/linux/Cargo.toml --locked && \
    cargo test --manifest-path clients/linux/Cargo.toml --locked --no-run --message-format=json > /app/clients/linux/target/unit-build.json
COPY scripts scripts
RUN mkdir -p /reports && chown 999:999 /reports
ENV HOME=/home/appuser CARGO_NET_OFFLINE=true
USER 999:999
CMD ["bash", "/app/scripts/linux-test.sh"]
