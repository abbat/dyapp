#!/usr/bin/env sh
_repo_root=$(git rev-parse --show-toplevel) || exit 1
if ! python3 -B "$_repo_root/tests/scripts/check-batches.py" --staged --message-file "$1"; then
  echo >&2 "Batch policy: https://github.com/abbat/dyapp/blob/main/docs/development/code-quality.md#small-batches"
  exit 1
fi
if ! python3 -B "$_repo_root/tests/scripts/check-repository.py" --message-file "$1"; then
  echo >&2 "Commit message policy: https://github.com/abbat/dyapp/blob/main/docs/development/code-quality.md#git-hooks"
  exit 1
fi
