        }
      }
    },
    "lock.no.passcode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a device passcode in Settings to use a PIN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать PIN, задайте код-пароль в настройках устройства."
