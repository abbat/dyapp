    "notice.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name or a message reaches the macOS notification service and can show on the lock screen, as System Settings allows. Requests and likes always show only \"New message\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя и текст попадают в службу уведомлений macOS и могут появиться на экране блокировки, если это разрешено в Системных настройках. Запросы и лайки всегда показывают только «Новое сообщение»."
          }
        }
      }
    },
    "notice.hintIos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name or a message reaches the iOS notification service, and only while Show Previews in iOS Settings keeps them off the lock screen. iOS decides when a closed app receives, so a notice can come late. Requests and likes always show only \"New message\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя и текст попадают в службу уведомлений iOS, и только пока «Показ миниатюр» в настройках iOS не выводит их на экран блокировки. Когда закрытое приложение получает почту, решает iOS, поэтому уведомление может опоздать. Запросы и лайки всегда показывают только «Новое сообщение»."
          }
        }
      }
    },
