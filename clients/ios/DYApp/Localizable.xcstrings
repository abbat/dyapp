    "clear.later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleared messages do not come back, even if delivered again. Unsent messages are cancelled. The match stays."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищенные сообщения не вернутся, даже если придут повторно. Неотправленные сообщения отменяются. Взаимная симпатия остаётся."
          }
        }
      }
    },
    "clear.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All messages in this chat are deleted from this device. The other person keeps their copy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сообщения этой переписки удаляются с этого устройства. У собеседника они останутся."
          }
        }
      }
    },
    "clear.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear this chat?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить переписку?"
          }
        }
      }
    },
