        "en": { "stringUnit": { "state": "translated", "value": "Blocked on this device. A node accepted the token revocation." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Заблокирован на этом устройстве. Узел подтвердил отзыв токенов." } }
      }
