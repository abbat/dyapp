{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DYApp"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DYApp"
          }
        }
      }
    },
    "identity.lossWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Losing every copy of this key loses this identity. Create a new one only if this is a new install or you accept that loss."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеря всех копий ключа означает потерю личности. Создавайте новую только при первой установке или если принимаете эту потерю."
          }
        }
      }
    },
    "identity.create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create identity"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать личность"
          }
        }
      }
    },
    "identity.recovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved identity cannot be opened. Restore its key or retry; a new key will not be created."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть сохранённую личность. Восстановите ключ или повторите попытку; новый ключ не будет создан."
          }
        }
      }
    },
    "identity.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        }
      }
    },
    "identity.picker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an identity to continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите личность, чтобы продолжить."
          }
        }
      }
    },
    "network.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Network connection" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подключение к сети" } }
      }
    },
    "settings.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Settings" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Настройки" } }
      }
    },
    "settings.identities": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Identities on this device" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Идентичности на устройстве" } }
      }
    },
    "settings.keychain": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Device Keychain + local key file" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Связка ключей устройства + локальный файл ключа" } }
      }
    },
    "settings.active": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Active" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Активная" } }
      }
    },
    "settings.loading": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Loading identities…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Загрузка идентичностей…" } }
      }
    },
    "settings.readFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The identity list could not be read. Retry after checking device storage." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось прочитать список идентичностей. Проверьте хранилище и повторите попытку." } }
      }
    },
    "settings.pending": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Creation incomplete" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Создание не завершено" } }
      }
    },
    "settings.unavailable": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Key unavailable" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ключ недоступен" } }
      }
    },
    "settings.deleting": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Removal incomplete" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удаление не завершено" } }
      }
    },
    "settings.damaged": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Slot damaged" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Хранилище повреждено" } }
      }
    },
    "settings.select": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Switch to this identity" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Переключиться на эту идентичность" } }
      }
    },
    "settings.create": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Create another identity" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Создать другую идентичность" } }
      }
    },
    "settings.createWarning": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A new identity has a separate Peer ID and local key. A missing key cannot be replaced by creating another identity." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Новая идентичность получит отдельный Peer ID и локальный ключ. Создание другой идентичности не восстановит потерянный ключ." } }
      }
    },
    "settings.working": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Updating identity…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Обновление идентичности…" } }
      }
    },
    "settings.actionFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The identity action failed. Check device storage and retry; your current key was not replaced." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось выполнить действие. Проверьте хранилище и повторите попытку; текущий ключ не заменён." } }
      }
    },
    "settings.remove": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remove this identity" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить эту идентичность" } }
      }
    },
    "settings.removeTitle": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remove identity?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить идентичность?" } }
      }
    },
    "settings.removeCancel": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep identity" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Оставить идентичность" } }
      }
    },
    "settings.removeConfirm": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remove permanently" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить навсегда" } }
      }
    },
    "settings.removeLastWarning": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This is the last local copy shown on this device. The key cannot be recovered without a backup." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Это последняя локальная копия на этом устройстве. Без резервной копии ключ нельзя восстановить." } }
      }
    },
    "settings.removeWarning": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This key cannot be recovered without a backup. Other identities will remain on this device." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Без резервной копии этот ключ нельзя восстановить. Другие идентичности останутся на устройстве." } }
      }
    },
    "network.activeReadFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The active network could not be read. Retry after fixing its file." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось прочитать активную сеть. Исправьте файл и повторите попытку." } }
      }
    },
    "network.bootstrap": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Bootstrap nodes" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Начальные узлы" } }
      }
    },
    "network.bootstrapHelp": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "One host:port per line, in connection order. IPv6 addresses use brackets; an optional /peer ID pins a node." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Один адрес хост:порт на строку, в порядке подключения. IPv6 указывайте в скобках; необязательный /ID узла закрепляет узел." } }
      }
    },
    "network.name": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Network name" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Название сети" } }
      }
    },
    "network.nameHelp": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Leave blank for the public network." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Оставьте пустым для публичной сети." } }
      }
    },
    "network.draftPending": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Save this draft to keep it for later, or check the connection now." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сохраните черновик, чтобы вернуться к нему позже, или проверьте подключение сейчас." } }
      }
    },
    "network.save": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Save draft" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сохранить черновик" } }
      }
    },
    "network.unsaved": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Unsaved changes" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Есть несохранённые изменения" } }
      }
    },
    "network.saving": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Saving draft…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сохранение черновика…" } }
      }
    },
    "network.saved": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Draft saved. The active connection has not changed." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Черновик сохранён. Активное подключение не изменилось." } }
      }
    },
    "network.saveFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not save the draft. Your edits are still here; try again." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось сохранить черновик. Изменения остались на экране; попробуйте снова." } }
      }
    },
    "network.check": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check connection" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверить подключение" } }
      }
    },
    "network.retry": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Retry connection" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Повторить подключение" } }
      }
    },
    "network.cancel": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cancel check" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отменить проверку" } }
      }
    },
    "network.cancelling": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cancelling check…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отмена проверки…" } }
      }
    },
    "network.cancelled": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check cancelled. Draft and active connection were kept." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверка отменена. Черновик и активное подключение сохранены." } }
      }
    },
    "network.checkReady": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check the saved or edited addresses before continuing." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверьте сохранённые или изменённые адреса перед продолжением." } }
      }
    },
    "network.checking": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Checking connection…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверка подключения…" } }
      }
    },
    "network.checkFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connection check failed. Edit the draft and try again." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверка подключения не удалась. Измените черновик и повторите попытку." } }
      }
    },
    "network.connected": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A compatible node answered. Continue to activate this connection." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Совместимый узел ответил. Продолжите, чтобы активировать подключение." } }
      }
    },
    "network.unreachable": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No compatible node answered. The active connection is unchanged." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ни один совместимый узел не ответил. Активное подключение не изменилось." } }
      }
    },
    "network.row.connected": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connected" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подключено" } }
      }
    },
    "network.row.invalidAddress": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Invalid address" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Неверный адрес" } }
      }
    },
    "network.row.invalidPeerID": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Invalid peer ID" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Неверный ID узла" } }
      }
    },
    "network.row.duplicate": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Duplicate address" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Повторяющийся адрес" } }
      }
    },
    "network.row.unreachable": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Unreachable" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Недоступен" } }
      }
    },
    "network.row.wrongPeer": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Wrong pinned peer" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не совпадает закреплённый узел" } }
      }
    },
    "network.row.wrongNetwork": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Wrong network" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Другая сеть" } }
      }
    },
    "network.continue": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Continue" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Продолжить" } }
      }
    },
    "network.activating": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Activating connection…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Активация подключения…" } }
      }
    },
    "network.activateFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not activate this connection. The previous active settings were kept." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось активировать подключение. Прежние активные настройки сохранены." } }
      }
    },
    "network.loading": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Loading network draft…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Загрузка черновика сети…" } }
      }
    },
    "network.readFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The saved network draft could not be read. Its file and identity were kept; fix the file before editing." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось прочитать сохранённый черновик сети. Файл и личность сохранены; исправьте файл перед редактированием." } }
      }
    },
    "status.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "app.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App is locked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение заблокировано"
          }
        }
      }
    },
    "lock.setup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect the app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите приложение"
          }
        }
      }
    },
    "lock.setup.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PIN of 6 to 64 digits hides your identities and chats until you enter it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN из 6–64 цифр скрывает ваши идентичности и чаты, пока вы его не введёте."
          }
        }
      }
    },
    "lock.pin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN"
          }
        }
      }
    },
    "lock.pin.repeat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat the PIN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите PIN"
          }
        }
      }
    },
    "lock.pin.short": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN needs at least 6 digits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN должен содержать не меньше 6 цифр."
          }
        }
      }
    },
    "lock.pin.mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PINs do not match."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN не совпадают."
          }
        }
      }
    },
    "lock.pin.wrong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong PIN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный PIN."
          }
        }
      }
    },
    "lock.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN could not be checked. Try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить PIN. Попробуйте ещё раз."
          }
        }
      }
    },
    "lock.device.credential": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong PINs. Unlock with the device passcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неверных PIN. Разблокируйте код-паролем устройства."
          }
        }
      }
    },
    "lock.set": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set PIN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить PIN"
          }
        }
      }
    },
    "lock.skip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить"
          }
        }
      }
    },
    "lock.unlock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
