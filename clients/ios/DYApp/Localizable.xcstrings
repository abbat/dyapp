    "chat.firstNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have not matched yet, so you can send one message until they reply."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взаимности пока нет, поэтому до ответа можно отправить одно сообщение."
          }
        }
      }
    },
    "chat.firstWait": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a reply. A like from them also opens the chat."
