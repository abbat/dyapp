    },
    "chat.closedNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You no longer match, so this chat is closed. A new match reopens it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взаимной симпатии больше нет, поэтому переписка закрыта. Новая взаимная симпатия откроет её снова."
          }
        }
      }
    },
    "chat.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
