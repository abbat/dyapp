      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Blocked on this device. No issued tokens needed revocation." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Заблокирован на этом устройстве. Выданных токенов для отзыва нет." } }
      }
    },
    "chats.blockedConfirmed": {
