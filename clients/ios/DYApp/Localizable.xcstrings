    "lock.pin.mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PINs do not match."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN не совпадают."
          }
