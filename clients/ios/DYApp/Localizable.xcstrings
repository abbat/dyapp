    "search.mutual": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Only people looking for someone like me" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Только те, кто ищет таких, как я" } }
      }
    },
    "search.mutualHint": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Shows profiles that seek your gender and age. Search nodes see your gender and age for this search. Uses your saved profile." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показывает профили, которые ищут ваш пол и возраст. На время этого поиска узлы видят ваш пол и возраст. Используется сохранённый профиль." } }
      }
    },
    "search.mutualUnavailable": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Mutual search needs your gender and a birth date that gives your exact age. Add them to your saved profile." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Для взаимного поиска нужны ваш пол и дата рождения, по которой точно известен возраст. Добавьте их в сохранённый профиль." } }
      }
    },
    "search.failureNoNodes": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No search node was found on the network." } },
        "ru": { "stringUnit": { "state": "translated", "value": "В сети не найден ни один узел поиска." } }
      }
    },
    "search.failureUnavailable": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A search node could not be reached or would not serve the search." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Узел поиска недоступен или отказался выполнять поиск." } }
      }
    },
    "search.failureTimeout": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A search node did not answer in time." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Узел поиска не ответил вовремя." } }
      }
    },
    "search.failureRateLimited": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A search node is busy. Seconds to wait: %1$@" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Узел поиска занят. Подождите, секунд: %1$@" } }
      }
    },
    "search.failurePuzzle": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A search node asked for proof of work the app does not solve." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Узел поиска запросил доказательство работы, которое приложение не решает." } }
      }
    },
    "search.failureInvalid": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A search node sent a malformed or forged reply; it was dropped." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Узел поиска прислал искажённый или поддельный ответ; он отброшен." } }
      }
    },
    "search.peer": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Peer ID: %1$@" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Peer ID: %1$@" } }
      }
    },
    "view.back": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Back to results" } },
        "ru": { "stringUnit": { "state": "translated", "value": "К результатам" } }
      }
