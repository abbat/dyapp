{
  "sourceLanguage": "en",
  "strings": {
    "app.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App is locked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение заблокировано"
          }
        }
      }
    },
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DYApp"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DYApp"
          }
        }
      }
    },
    "block.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are hidden from search and chats on your devices and are not told. Texts they send while blocked are dropped."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет скрыт из поиска и чатов на ваших устройствах и ничего не узнает. Его сообщения во время блокировки отбрасываются."
          }
        }
      }
    },
    "block.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block this person?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировать этого человека?"
          }
        }
      }
    },
    "chat.block": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировать"
          }
        }
      }
    },
    "chat.blockFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person could not be blocked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось заблокировать человека."
          }
        }
      }
    },
