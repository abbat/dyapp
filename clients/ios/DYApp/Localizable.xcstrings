      }
    },
    "lock.recovery.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device passcode is off. Turn it on in Settings to recover a forgotten PIN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код-пароль устройства выключен. Включите его в настройках, чтобы восстановить забытый PIN."
          }
        }
      }
    },
    "lock.reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device passcode confirmed. Set a new PIN or turn the PIN off."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код-пароль устройства подтверждён. Задайте новый PIN или отключите его."
