{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DYApp"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DYApp"
          }
        }
      }
    },
    "status.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "app.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App is locked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение заблокировано"
          }
        }
      }
    },
    "lock.setup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect the app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите приложение"
          }
        }
      }
    },
    "lock.setup.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PIN of 6 to 64 digits hides your identities and chats until you enter it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN из 6–64 цифр скрывает ваши идентичности и чаты, пока вы его не введёте."
          }
        }
      }
    },
    "lock.pin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN"
          }
        }
      }
    },
    "lock.pin.repeat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat the PIN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите PIN"
          }
        }
      }
    },
    "lock.pin.short": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN needs at least 6 digits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN должен содержать не меньше 6 цифр."
          }
        }
      }
    },
    "lock.pin.mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PINs do not match."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN не совпадают."
          }
        }
      }
    },
    "lock.pin.wrong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong PIN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный PIN."
          }
        }
      }
    },
    "lock.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN could not be checked. Try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить PIN. Попробуйте ещё раз."
          }
        }
      }
    },
    "lock.device.credential": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong PINs. Unlock with the device passcode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неверных PIN. Разблокируйте код-паролем устройства."
          }
        }
      }
    },
    "lock.set": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set PIN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить PIN"
          }
        }
      }
    },
    "lock.skip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить"
          }
        }
      }
    },
    "lock.unlock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать"
          }
        }
      }
    }
  },
  "version": "1.0"
}
