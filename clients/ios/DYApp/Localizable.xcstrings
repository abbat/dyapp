      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Message" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Написать" } }
      }
    },
    "view.like": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Like" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Нравится" } }
      }
    },
    "view.liked": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Liked" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Вы отметили" } }
      }
    },
    "view.match": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You like each other." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Симпатия взаимна." } }
      }
    },
    "view.matchText": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Write as much as you like." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Пишите сколько хотите." } }
      }
    },
    "view.firstHint": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Until you like each other, you can send one message and then wait for a reply." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Пока симпатия не взаимна, можно отправить одно сообщение и дождаться ответа." } }
      }
    },
    "view.unlikeHint": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Press Liked to take the like back; the match ends for both of you." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Нажмите «Вы отметили», чтобы отменить; взаимность пропадёт у обоих." } }
      }
    },
    "view.sending": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sending…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отправка…" } }
      }
    },
    "view.likeFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The like was not sent." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Симпатия не отправлена." } }
      }
    },
    "view.likeUnpublished": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Publish your profile first, so the other person sees who likes them." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сначала опубликуйте профиль, чтобы человек видел, кому он понравился." } }
      }
    },
    "view.likeNotConnected": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No active network node answered. Check the connection, then retry." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Нет ответа от узла действующей сети. Проверьте подключение и повторите." } }
      }
    },
    "view.likePending": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Saved on this device. It goes out when a node answers." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сохранено на этом устройстве. Уйдёт, когда ответит узел." } }
      }
    },
    "view.pass": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pass" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Пропустить" } }
      }
    },
    "view.unpass": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Undo pass" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отменить пропуск" } }
      }
    },
    "view.passed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Passed. They are hidden from your search and Liked you, and they are not told." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Пропущено. Человек скрыт из вашего поиска и списка «Вы понравились» и об этом не узнает." } }
      }
    },
    "view.unpassed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pass undone. They can appear in your search and Liked you again." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Пропуск отменён. Человек снова может появиться в поиске и списке «Вы понравились»." } }
      }
    },
    "view.passFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The pass was not saved." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Пропуск не сохранён." } }
      }
    },
    "view.loading": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Loading the profile…" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Загрузка профиля…" } }
      }
    },
    "view.notFound": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No node returned this profile: it may be hidden or withdrawn." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ни один узел не вернул этот профиль: возможно, его скрыли или сняли с публикации." } }
      }
    },
    "view.loadFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The profile could not be loaded." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось загрузить профиль." } }
      }
    },
    "unlike.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Take the like back?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отменить симпатию?" } }
      }
    },
    "unlike.text": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "If you match, the chat closes for both of you and your copy is erased; theirs stays with them. You can like again later." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Если симпатия взаимна, переписка закроется у обоих и ваша копия удалится; копия собеседника останется. Отметить снова можно позже." } }
      }
    },
    "unlike.action": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Take back" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отменить симпатию" } }
      }
    },
    "chat.closedNotice": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You no longer match, so this chat is closed. A new match reopens it." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Взаимной симпатии больше нет, поэтому переписка закрыта. Новая взаимная симпатия откроет её снова." } }
      }
    },
    "chat.firstNotice": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You have not matched yet, so you can send one message until they reply." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Взаимности пока нет, поэтому до ответа можно отправить одно сообщение." } }
      }
