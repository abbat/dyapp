<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the database, MLS state and wrapped keys are useless elsewhere
     and must not reach a cloud backup or another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
