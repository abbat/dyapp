{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DYApp",
  "version": "0.0.1",
  "identifier": "com.dyapp",
  "build": {
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DYApp",
        "width": 1024,
        "height": 720,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
