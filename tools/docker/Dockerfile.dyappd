# The dyappd container image: the release binary and the Debian 12 glibc libraries it links, on
# an empty base. No shell, no package manager; runs as 65532 with one volume at /var/lib/dyappd.
FROM dyapp:deb AS build
# The build stage only; the image runs as 65532.
# hadolint ignore=DL3002
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY proto proto
COPY rust rust
COPY tools/scripts/check-auditable.py tools/scripts/check-hardening.py tools/scripts/
# The library paths split on purpose and hold no spaces; if ldd fails, cp gets no source and fails.
# Debian's hardening flags reach the bundled C code as in tools/scripts/build-deb.sh.
# hadolint ignore=SC2046
RUN CFLAGS="$(dpkg-buildflags --get CFLAGS) $(dpkg-buildflags --get CPPFLAGS)" \
    cargo auditable build --release --locked --offline --package dyapp-bootstrap --bin dyappd \
    && install -D -s -m 0755 build/release/dyappd /out/usr/bin/dyappd \
    && python3 -B tools/scripts/check-auditable.py /out/usr/bin/dyappd Cargo.lock \
    && python3 -B tools/scripts/check-hardening.py /out/usr/bin/dyappd \
    && cp -L --parents $(ldd build/release/dyappd | grep -o '/[^ ]*') /out \
    && install -d -m 0700 -o 65532 -g 65532 /out/var/lib/dyappd

FROM scratch
COPY --from=build /out /
USER 65532:65532
ENV RUST_LOG=info DYAPPD_LISTEN='["[::]:33445", "0.0.0.0:33445"]'
VOLUME /var/lib/dyappd
EXPOSE 33445/tcp 33445/udp
ENTRYPOINT ["/usr/bin/dyappd"]
