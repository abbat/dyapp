FROM rust@sha256:3745c050d12adc738eff16ebfc81ed044bfb2cc27c6828850ff1666beb1c7a49 AS rust
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config ca-certificates libssl-dev libgtk-3-dev \
    libwebkit2gtk-4.1-dev libxdo-dev libayatana-appindicator3-dev librsvg2-dev python3 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ARG DYAPP_CPUS=4
ENV PATH=/usr/local/cargo/bin:$PATH RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo RUSTUP_TOOLCHAIN=1.99.0 \
    CARGO_BUILD_JOBS=$DYAPP_CPUS CMAKE_BUILD_PARALLEL_LEVEL=$DYAPP_CPUS MAKEFLAGS=-j$DYAPP_CPUS \
    RAYON_NUM_THREADS=$DYAPP_CPUS
RUN groupadd -g 1000 appuser && useradd -m -u 1000 -g 1000 appuser
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY rust rust
COPY proto proto
COPY clients clients
# Only the crates: builds go to the mounted checkout (linux-test, deb).
# Some crate archives keep 0640 files; the tests run as the host user.
RUN cargo fetch --locked && \
    cargo fetch --locked --manifest-path clients/linux/Cargo.toml && \
    chmod -R a+rX /usr/local/cargo/registry
ENV HOME=/home/appuser CARGO_NET_OFFLINE=true
