FROM rust@sha256:3745c050d12adc738eff16ebfc81ed044bfb2cc27c6828850ff1666beb1c7a49
ARG DYAPP_CPUS=4
ENV RUSTUP_TOOLCHAIN=1.99.0 CARGO_BUILD_JOBS=$DYAPP_CPUS \
    CMAKE_BUILD_PARALLEL_LEVEL=$DYAPP_CPUS MAKEFLAGS=-j$DYAPP_CPUS RAYON_NUM_THREADS=$DYAPP_CPUS \
    CXXFLAGS=-g0
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config protobuf-compiler libssl-dev \
    python3-flake8 python3-yaml python3-pyflakes shellcheck openjdk-21-jre-headless unzip && \
    rm -rf /var/lib/apt/lists/*
# Official actionlint 1.7.12.
COPY --from=rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 /usr/local/bin/actionlint /usr/local/bin/actionlint
# Official gitleaks 8.30.1.
COPY --from=zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f /usr/bin/gitleaks /usr/local/bin/gitleaks
# typos 1.50.3, taplo 0.10.0, cargo-shear 1.14.0, SwiftLint 0.65.1, detekt 1.23.8, zizmor 1.30.1, age 1.3.2,
# Biome 2.6.3, rumdl 0.3.1, hadolint 2.15.1 and buf 1.75.0 release binaries, the same checksums as
# tools/scripts/ci-setup.sh.
RUN curl -fsSL -o /usr/local/bin/biome https://github.com/biomejs/biome/releases/download/%40biomejs%2Fbiome%402.6.3/biome-linux-x64-musl && \
    curl -fsSL -o /tmp/rumdl.tgz https://github.com/rvben/rumdl/releases/download/v0.3.1/rumdl-v0.3.1-x86_64-unknown-linux-musl.tar.gz && \
    curl -fsSL -o /usr/local/bin/hadolint https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64 && \
    curl -fsSL -o /usr/local/bin/buf https://github.com/bufbuild/buf/releases/download/v1.75.0/buf-Linux-x86_64 && \
    curl -fsSL -o /tmp/typos.tgz https://github.com/crate-ci/typos/releases/download/v1.50.3/typos-v1.50.3-x86_64-unknown-linux-musl.tar.gz && \
    curl -fsSL -o /tmp/taplo.gz https://github.com/tamasfe/taplo/releases/download/0.10.0/taplo-linux-x86_64.gz && \
    curl -fsSL -o /tmp/shear.tgz https://github.com/Boshen/cargo-shear/releases/download/v1.14.0/cargo-shear-x86_64-unknown-linux-musl.tar.gz && \
    curl -fsSL -o /tmp/swiftlint.zip https://github.com/realm/SwiftLint/releases/download/0.65.1/swiftlint_linux_amd64.zip && \
    curl -fsSL -o /tmp/zizmor.tgz https://github.com/zizmorcore/zizmor/releases/download/v1.30.1/zizmor-x86_64-unknown-linux-gnu.tar.gz && \
    curl -fsSL -o /usr/local/lib/detekt-cli.jar https://github.com/detekt/detekt/releases/download/v1.23.8/detekt-cli-1.23.8-all.jar && \
    curl -fsSL -o /tmp/age.tgz https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-linux-amd64.tar.gz && \
    printf '%s\n' 'aca6b5d546307092b8d0a8e0a89dd80f9da51f2f7617c5e45c5607c1684ffbf2  /tmp/typos.tgz' \
        '8fe196b894ccf9072f98d4e1013a180306e17d244830b03986ee5e8eabeb6156  /tmp/taplo.gz' \
        '9004df4eb031a456026c4326ae0d0ce545321527a67be90f4524c1be729dc40e  /tmp/shear.tgz' \
        'caeed6f4a679c35539ffaf124f6c4ab4a8416917f7d8796279dc52b74026059d  /tmp/swiftlint.zip' \
        'e65324f4430c2717591937edcec90ccbefaf14c174f8ec9415e03ca875b46e1a  /tmp/zizmor.tgz' \
        '2ce2ff952e150baf28a29cda70a363b0340b3e81a55f43e51ec5edffc3d066c1  /usr/local/lib/detekt-cli.jar' \
        'cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10  /tmp/age.tgz' \
        'fd1249e77e57c21d6e5e6c1102f2f19ee5fda140b6126f6ff24a70e789a5d526  /usr/local/bin/biome' \
        '81a389a894f3e22233b9e94f385d784744362ee7ed3fffde532ea6f1c9b392fd  /tmp/rumdl.tgz' \
        'c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507  /usr/local/bin/hadolint' \
        'fad1e38d6909bbb583a4da81d8c02a01046e2cd663bde7e337dd24277393764b  /usr/local/bin/buf' | sha256sum -c - && \
    tar -xzf /tmp/typos.tgz -C /usr/local/bin ./typos && \
    tar -xzf /tmp/rumdl.tgz -C /usr/local/bin rumdl && \
    tar -xzf /tmp/shear.tgz -C /usr/local/bin cargo-shear && \
    tar -xzf /tmp/zizmor.tgz -C /usr/local/bin zizmor && \
    tar -xzf /tmp/age.tgz -C /usr/local/bin --strip-components=1 age/age age/age-keygen && \
    gunzip -c /tmp/taplo.gz > /usr/local/bin/taplo && \
    unzip -p /tmp/swiftlint.zip swiftlint-static > /usr/local/bin/swiftlint && \
    chmod 755 /usr/local/bin/typos /usr/local/bin/taplo /usr/local/bin/cargo-shear /usr/local/bin/swiftlint \
        /usr/local/bin/zizmor /usr/local/bin/age /usr/local/bin/age-keygen /usr/local/bin/biome \
        /usr/local/bin/rumdl /usr/local/bin/hadolint /usr/local/bin/buf && \
    chmod 644 /usr/local/lib/detekt-cli.jar && \
    rm -f /tmp/typos.tgz /tmp/taplo.gz /tmp/shear.tgz /tmp/swiftlint.zip /tmp/zizmor.tgz /tmp/age.tgz /tmp/rumdl.tgz
RUN rustup component add rustfmt clippy llvm-tools-preview --toolchain 1.99.0
RUN cargo install --locked cargo-llvm-cov --version 0.9.1 && \
    cargo install --locked cargo-deny --version 0.20.2 && \
    cargo install --locked cargo-nextest --version 0.9.148 && \
    cargo install --locked cargo-mutants --version 27.1.0 && \
    cargo install --locked cargo-fuzz --version 0.13.2
RUN groupadd -g 1000 appuser && useradd -m -u 1000 -g 1000 appuser
WORKDIR /workspace
COPY . .
# Dependency preparation is online; all runtime test commands are offline.
RUN cargo fetch --locked && cargo fetch --locked --manifest-path tests/fuzz/Cargo.toml && \
    cargo fetch --locked --manifest-path clients/linux/Cargo.toml && \
    cargo fetch --locked --manifest-path clients/windows/Cargo.toml && \
    chmod -R a+rX /usr/local/cargo/registry
RUN cargo deny fetch db && cp -rf /tmp/ai/advisory-dbs /opt/advisory-dbs && \
    chmod -R a+rX /opt/advisory-dbs
RUN mkdir -p /workspace/build && chown -R 1000:1000 /workspace/build
ENV HOME=/home/appuser CARGO_NET_OFFLINE=true
USER 1000:1000
CMD ["cargo", "test", "--workspace", "--locked", "--offline"]
