[Unit]
Description=dyapp bootstrap node
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=dyappd
Group=dyappd
ExecStart=/usr/bin/dyappd --config /etc/dyappd.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
LimitNOFILE=65536
UMask=0077
# Resource bounds. limits.max_memory_mb (768 by default) keeps dyappd under MemoryHigh: from
# 80 % of it requests are refused, at 100 % dropped. Raise both together in a drop-in.
MemoryHigh=768M
MemoryMax=1G
CPUQuota=150%
TasksMax=256
# /var/lib/dyappd, owned by the service user. Stores configured elsewhere need a drop-in
# with ReadWritePaths=.
StateDirectory=dyappd
StateDirectoryMode=0750
ReadWritePaths=/var/lib/dyappd

# No capabilities: the default ports are above 1024. For a port below 1024 add a drop-in with
# AmbientCapabilities=CAP_NET_BIND_SERVICE and CapabilityBoundingSet=CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Netlink: libp2p watches the interface addresses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
