[Unit]
Description=dyapp bootstrap node
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=dyappd
Group=dyappd
ExecStart=/usr/bin/dyappd --config /etc/dyappd.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
LimitNOFILE=65536
UMask=0077
# Resource bounds. limits.max_memory_mb (768 by default) keeps dyappd under MemoryHigh: from
# 80 % of it requests are refused, at 100 % dropped. Raise both together in a drop-in.
MemoryHigh=768M
MemoryMax=1G
CPUQuota=150%
TasksMax=256
# Keys stay out of core dumps and swap (dyappd also makes itself non-dumpable). MemorySwapMax
# needs cgroup v2. A live hypervisor read is not covered: only a confidential VM is.
LimitCORE=0
MemorySwapMax=0
# The node key sealed by systemd-creds, looked up by name in /etc/credstore.encrypted. Absent, it
# is skipped and dyappd reads storage.dir/node.key (or storage.key) instead.
LoadCredentialEncrypted=node.key
# /var/lib/dyappd, owned by the service user. Stores configured elsewhere need a drop-in
# with ReadWritePaths=.
StateDirectory=dyappd
StateDirectoryMode=0750
ReadWritePaths=/var/lib/dyappd
# The key cannot be replaced (bind mount: no write, rename or unlink); "-" lets the unit start
# before keygen.
ReadOnlyPaths=-/var/lib/dyappd/node.key -/var/lib/dyappd/node.id
# Files dropped into the data directory cannot run; /usr is read-only under ProtectSystem=strict.
NoExecPaths=/
ExecPaths=/usr

# No capabilities: the default ports are above 1024. For a port below 1024 add a drop-in with
# AmbientCapabilities=CAP_NET_BIND_SERVICE and CapabilityBoundingSet=CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
RemoveIPC=yes
KeyringMode=private
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Cloud metadata and link-local; extend with a drop-in. A link-local DNS resolver needs the
# BindReadOnlyPaths fix in docs/manuals/bootstrap.md.
IPAddressDeny=169.254.0.0/16 fe80::/10 fd00:ec2::254/128 100.100.100.200/32
IPAccounting=yes
# Netlink: libp2p watches the interface addresses. Unix: glibc NSS (nscd, resolved) and the
# planned local CLI socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
