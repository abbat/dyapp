[Unit]
Description=dyapp bootstrap node
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=dyapp-node
Group=dyapp-node
ExecStart=/usr/bin/dyapp-node --config /etc/dyapp-node.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
LimitNOFILE=65536
UMask=0077
# /var/lib/dyapp-node, owned by the service user. Stores configured elsewhere need a drop-in
# with ReadWritePaths=.
StateDirectory=dyapp-node
StateDirectoryMode=0750
ReadWritePaths=/var/lib/dyapp-node

# No capabilities: the default ports are above 1024. For a port below 1024 add a drop-in with
# AmbientCapabilities=CAP_NET_BIND_SERVICE and CapabilityBoundingSet=CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Netlink: libp2p watches the interface addresses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
