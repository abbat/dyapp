+//! Resource and raster planning; a plan is not a validation of encoded image contents.
+use super::scan::MAX_SCAN_SIDE;
+
+/// Encoded file size admitted before platform image decoding.
+pub const MAX_ENCODED_BYTES: u64 = 2 * 1024 * 1024;
+/// Original file-image pixels admitted before allocating its decoded raster.
+pub const MAX_ORIGINAL_PIXELS: u64 = 16_000_000;
+
+/// Authoritative hints for platform input adapters; the scanner still validates every frame.
+#[derive(Clone, Copy, Debug, Eq, PartialEq, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ScanPolicy {
+    /// Maximum encoded input-file bytes.
+    pub max_encoded_bytes: u64,
+    /// Maximum decoded original file-image pixels.
+    pub max_original_pixels: u64,
+    /// Maximum side after rasterization.
+    pub max_frame_side: u32,
+}
+
+/// Exact target dimensions preserving aspect ratio without upscaling.
+#[derive(Clone, Copy, Debug, Eq, PartialEq, serde::Serialize)]
+pub struct ScanDimensions {
+    /// Positive target width, at most the shared scanner side.
+    pub width: u32,
+    /// Positive target height, at most the shared scanner side.
+    pub height: u32,
+}
+
+/// Current resource policy, without identity admission or network activity.
+#[must_use]
+pub const fn scan_policy() -> ScanPolicy {
+    ScanPolicy {
+        max_encoded_bytes: MAX_ENCODED_BYTES,
+        max_original_pixels: MAX_ORIGINAL_PIXELS,
+        max_frame_side: MAX_SCAN_SIDE,
+    }
+}
+
+/// Plan an already available camera or bitmap raster; no original-file budget applies here.
+#[must_use]
+pub fn frame_plan(width: u32, height: u32) -> Option<ScanDimensions> {
+    if width == 0 || height == 0 {
+        return None;
+    }
+    let longest = u64::from(width.max(height));
+    let target = longest.min(u64::from(MAX_SCAN_SIDE));
+    let fit = |side| {
+        u32::try_from((u64::from(side) * target + longest / 2) / longest)
+            .ok()
+            .map(|value| value.max(1))
+    };
+    Some(ScanDimensions {
+        width: fit(width)?,
+        height: fit(height)?,
+    })
+}
+
+/// Plan platform file decoding from its actual header dimensions and encoded length.
+///
+/// A successful plan only bounds allocation; the platform must still decode the actual file.
+#[must_use]
+pub fn decode_plan(encoded_bytes: u64, width: u32, height: u32) -> Option<ScanDimensions> {
+    if encoded_bytes > MAX_ENCODED_BYTES
+        || u64::from(width) * u64::from(height) > MAX_ORIGINAL_PIXELS
+    {
+        return None;
+    }
+    frame_plan(width, height)
+}
+
+#[cfg(test)]
+mod tests;
