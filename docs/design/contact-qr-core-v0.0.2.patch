+//! Bounded contact-code comparison shared by desktop and native presentation.
+use dyapp_identity::safety::{qr_matches_peer_ids, qr_payload_for_peer_ids};
+
+/// Maximum side of a grayscale QR frame accepted by the shared scanner.
+pub const MAX_SCAN_SIDE: u32 = 768;
+
+/// A comparison outcome, never authority to mark a contact verified.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ScanOutcome {
+    /// Exactly one decoded code belongs to the expected ordered pair.
+    Matched,
+    /// The decoded version is supported, but the pair does not match.
+    Foreign,
+    /// The decoded payload has an unsupported length or version.
+    Invalid,
+    /// A detected symbol could not be decoded.
+    Unreadable,
+    /// More than one symbol was detected, irrespective of decode success.
+    Multiple,
+    /// No symbol was detected.
+    NotFound,
+}
+
+impl ScanOutcome {
+    /// Stable desktop transport code; native adapters may instead project the typed variants.
+    #[must_use]
+    pub const fn code(self) -> &'static str {
+        match self {
+            Self::Matched => "matched",
+            Self::Foreign => "foreign",
+            Self::Invalid => "invalid",
+            Self::Unreadable => "unreadable",
+            Self::Multiple => "multiple",
+            Self::NotFound => "notFound",
+        }
+    }
+}
+
+/// Input admission failed before decoding or comparing a code.
+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub enum ScanError {
+    /// Nonpositive/oversized dimensions or a mismatched grayscale buffer.
+    #[error("invalid QR image dimensions")]
+    InvalidDimensions,
+    /// One of the supplied peer IDs is not canonical.
+    #[error("invalid Peer ID")]
+    InvalidPeer,
+}
+
+fn outcome(payload: Option<Vec<u8>>, expected: &[u8], mine: &str, theirs: &str) -> ScanOutcome {
+    match payload {
+        None => ScanOutcome::Unreadable,
+        Some(data) if data.len() != expected.len() || data.first() != expected.first() => {
+            ScanOutcome::Invalid
+        }
+        Some(data) if qr_matches_peer_ids(&data, mine, theirs) => ScanOutcome::Matched,
+        Some(_) => ScanOutcome::Foreign,
+    }
+}
+
+/// Compare a bounded row-major grayscale frame with the code the other peer should show.
+///
+/// This does not fetch profiles, write a contact mark or authorize a later confirmation.
+///
+/// # Errors
+/// Rejects invalid frame dimensions/length or noncanonical peer IDs before decoding.
+pub fn scan_contact(
+    width: u32,
+    height: u32,
+    pixels: &[u8],
+    mine: &str,
+    theirs: &str,
+) -> Result<ScanOutcome, ScanError> {
+    if width == 0 || height == 0 || width > MAX_SCAN_SIDE || height > MAX_SCAN_SIDE {
+        return Err(ScanError::InvalidDimensions);
+    }
+    let (width, height) = (width as usize, height as usize);
+    if pixels.len() != width * height {
+        return Err(ScanError::InvalidDimensions);
+    }
+    let expected = qr_payload_for_peer_ids(theirs, mine).ok_or(ScanError::InvalidPeer)?;
+    let mut decoder = quircs::Quirc::default();
+    let mut result = None;
+    for code in decoder.identify(width, height, pixels) {
+        if result.is_some() {
+            return Ok(ScanOutcome::Multiple);
+        }
+        let payload = code.ok().and_then(|code| code.decode().ok()).map(|data| data.payload);
+        result = Some(outcome(payload, &expected, mine, theirs));
+    }
+    Ok(result.unwrap_or(ScanOutcome::NotFound))
+}
+
+#[cfg(test)]
+mod tests;
