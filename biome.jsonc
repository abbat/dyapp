{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  // The desktop web UI, its static prototype and the Android one; JSON data files are not linted.
  "files": {
    "includes": ["clients/desktop/**/*.js", "clients/desktop/**/*.html", "clients/desktop/**/*.css",
      "clients/android/prototype/*"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  // Expand this enforced scope as the measured backlog is refactored.
  "overrides": [{
    "includes": [
      "clients/desktop/ui/**/*.js",
      "clients/desktop/prototype/**/*.js",
      "clients/desktop/video-frame-renderer.js",
      "clients/desktop/video-frame-smoke.js",
      "clients/desktop/ui-tests/removal.js",
      "clients/desktop/ui-tests/settings-lists.js",
      "clients/desktop/ui-tests/settings-nav.js",
      "clients/desktop/ui-tests/clear.js",
      "clients/desktop/ui-tests/composer.js",
      "clients/desktop/ui-tests/identifiers.js",
      "clients/desktop/ui-tests/chat-redraw.js",
      "clients/desktop/ui-tests/media-cache.js",
      "clients/desktop/ui-tests/sticker-removal.js",
      "clients/desktop/ui-tests/sticker-requests.js",
      "clients/desktop/ui-tests/sticker-messages.js",
      "clients/desktop/ui-tests/sticker-picker.js",
      "clients/desktop/ui-tests/stickers.js",
      "clients/desktop/ui-tests/common.js",
      "clients/desktop/ui-tests/system-steps.js",
      "clients/desktop/ui-tests/ready-step.js",
      "clients/desktop/ui-tests/add-step.js",
      "clients/desktop/ui-tests/main.js",
      "clients/desktop/ui-tests/*-guard*.js",
      "clients/desktop/ui-tests/guards.js",
      "clients/desktop/ui-tests/profile-photos.js",
      "clients/desktop/ui-tests/peer-photos.js",
      "clients/desktop/ui-tests/chat-photo-fixture.js",
      "clients/desktop/ui-tests/photo-settings.js",
      "clients/desktop/ui-tests/chat-photo-send.js"
    ],
    "linter": { "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 50, "skipBlankLines": true, "skipIifes": true }
        }
      }
    } }
  }],
  "assist": { "enabled": false },
  "html": { "linter": { "enabled": true } },
  "linter": {
    // The recommended rules, the default, with these changes.
    "rules": {
      "a11y": {
        // Label and heading text is filled at runtime from the i18n catalogs (data-i18n, data-t),
        // so the static markup has none; check-repository.py requires every data-i18n key to exist.
        "noLabelWithoutControl": "off",
        "useHeadingContent": "off"
      },
      "style": {
        // style.css groups rules by component, so a later component rule often has a lower
        // specificity than an earlier contextual one (.chat-head .menu, then .menu) on other
        // properties; the UI screenshots catch a cascade that changes the look.
        "noDescendingSpecificity": "off"
      }
    }
  }
}
