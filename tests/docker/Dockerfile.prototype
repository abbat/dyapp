# WebKitGTK under Xvfb, the engine the Linux client ships on, to screenshot the static desktop
# prototype; no Rust build.
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb xauth python3-gi python3-gi-cairo gir1.2-gtk-3.0 gir1.2-webkit2-4.1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY tests/scripts/prototype-shots.py /app/prototype-shots.py
