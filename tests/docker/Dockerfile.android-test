FROM rust@sha256:3745c050d12adc738eff16ebfc81ed044bfb2cc27c6828850ff1666beb1c7a49 AS rust
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS android-tools
ENV DEBIAN_FRONTEND=noninteractive \
    JAVA_TOOL_OPTIONS=-XX:ActiveProcessorCount=4 \
    CMAKE_BUILD_PARALLEL_LEVEL=4 MAKEFLAGS=-j4
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless curl unzip ca-certificates python3 build-essential \
    libnss3 libpulse0 libx11-6 libxcb1 libxcomposite1 libxcursor1 \
    libxi6 libxrandr2 libxtst6 libasound2 libglu1-mesa && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    ANDROID_SDK_ROOT=/opt/android-sdk GRADLE_USER_HOME=/opt/gradle-cache
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:$PATH
WORKDIR /tmp/ai
RUN curl -fL https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip -o sdk.zip && \
    echo '4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583  sdk.zip' | sha256sum -c - && \
    mkdir -p /opt/android-sdk/cmdline-tools && unzip -q sdk.zip -d /opt/android-sdk/cmdline-tools && \
    mv -f /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && rm -f sdk.zip
RUN yes | sdkmanager --licenses >/dev/null
RUN sdkmanager 'platforms;android-37.0' 'build-tools;36.0.0' 'platform-tools' 'emulator' 'system-images;android-31;default;x86_64' \
    'ndk;29.0.14206865'
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/29.0.14206865
# The app build compiles the Rust core (see clients/android/app/build.gradle); the build user owns the
# cargo home so it can fetch crates.
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust --chown=1000:1000 /usr/local/cargo /usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo RUSTUP_TOOLCHAIN=1.99.0 CARGO_BUILD_JOBS=4
RUN rustup target add aarch64-linux-android x86_64-linux-android
RUN groupadd -g 1000 appuser && useradd -m -u 1000 -g 1000 appuser

FROM android-tools
WORKDIR /app
RUN mkdir -p /opt/gradle-cache /reports /avd /app/build && chown 1000:1000 /app /app/build /opt/gradle-cache /reports /avd
ENV HOME=/home/appuser
USER 1000:1000
RUN cargo install cargo-ndk --version 4.1.2 --locked
COPY --chown=1000:1000 Cargo.toml Cargo.lock ./
COPY --chown=1000:1000 .cargo .cargo
COPY --chown=1000:1000 proto proto
COPY --chown=1000:1000 rust rust
COPY --chown=1000:1000 clients clients
RUN echo '3b8a25775a69158b5ad2b1d17a80a88dc7b40a352a73eb27d06c612a7ce68e98  clients/android/gradle/wrapper/gradle-wrapper.jar' | sha256sum -c -
# Build as 1000 so the outputs need no recursive chown (a copy-up layer doubles the image size).
# Compile and populate all runtime dependencies online; do not run tests in the build.
# The Release tasks only cache their Gradle dependencies (Release lint included) for the offline
# Release runner: its release Rust core is not built here and the packages are discarded.
RUN cd clients/android && ./gradlew --no-daemon :app:assembleDebug :app:assembleDebugAndroidTest :app:compileDebugUnitTestKotlin && \
    ./gradlew --no-daemon :app:assembleRelease :app:bundleRelease -x cargoNdkRelease && \
    rm -rf ../../build/android/app/outputs/apk/release ../../build/android/app/outputs/bundle/release
# Host dyappd for the emulator runner's loopback node; only the binary is kept.
RUN cargo build --locked -p dyapp-bootstrap --bin dyappd && \
    rm -rf build/debug/deps build/debug/build build/debug/incremental build/debug/.fingerprint
COPY tools/scripts tools/scripts
COPY tests/scripts tests/scripts
CMD ["bash", "/app/tests/scripts/android-test-in-container.sh", "unit"]
