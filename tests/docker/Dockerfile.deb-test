# A clean Debian 12 for the package test, with systemd only for systemd-analyze verify and procps
# for the package's Depends (the unit reloads with /bin/kill).
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends procps systemd \
    && rm -rf /var/lib/apt/lists/*
