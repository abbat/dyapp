{
  "build": {
    "devPath": "../desktop/ui",
    "distDir": "../desktop/ui",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "DYApp",
    "version": "0.0.1"
  },
  "tauri": {
    "bundle": {
      "active": false,
      "identifier": "com.dyapp"
    },
    "allowlist": {
      "all": false
    },
    "windows": [
      {
        "label": "main",
        "title": "DYApp",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  }
}
